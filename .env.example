# =============================================================================
# Land Record Digitization System - Environment Configuration
# =============================================================================
# Local CLI / Docker Compose: copy to repository-root .env.
# Never copy local values to Render.
# Render production values and complete instructions: docs/deployment.md.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Land Record Digitization System"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=landrecords
POSTGRES_PASSWORD=changeme
POSTGRES_DB=landrecords
# Render SQLite: DATABASE_URL_OVERRIDE=sqlite+aiosqlite:////var/data/landrecords.db
# Managed PostgreSQL (optional): set DATABASE_URL_OVERRIDE to the provider URL.
# DATABASE_URL is also accepted when DATABASE_URL_OVERRIDE is absent.
# Optional local development override, for example:
# DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./landrecords.db
DATABASE_URL_OVERRIDE=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Render sets both from its Key Value internal connection string.
CELERY_BROKER_URL_OVERRIDE=
CELERY_RESULT_BACKEND_OVERRIDE=

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible / MinIO)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
# Options: local (dev default, no external deps), minio, s3
LOCAL_STORAGE_DIR=uploads
# STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=land-records
MINIO_USE_SSL=false

# The existing s3 backend uses the MinIO SDK and the MINIO_* variables above.
# Use a hostname[:port] endpoint without a URL scheme and MINIO_USE_SSL=true.
# Render local storage: LOCAL_STORAGE_DIR=/var/data/uploads

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
# Supported: tesseract, google_vision, azure_cognitive, easyocr
OCR_PRIMARY_ENGINE=tesseract
# Leave empty (OCR_FALLBACK_ENGINE=) to skip loading EasyOCR/Torch on low-memory hosts.
OCR_FALLBACK_ENGINE=easyocr
OCR_LANGUAGES=eng,hin

# Google Vision (optional)
GOOGLE_VISION_CREDENTIALS_PATH=

# Azure Cognitive Services (optional)
AZURE_COGNITIVE_ENDPOINT=
AZURE_COGNITIVE_KEY=

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Supported: openai, anthropic, local
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local LLM (Ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif,bmp,webp

# -----------------------------------------------------------------------------
# Processing
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=2
PROCESSING_TIMEOUT_SECONDS=300
# auto   : Celery when a broker is configured, otherwise synchronous in production
# celery : always dispatch to Celery/Redis
# sync   : process inside the API request (Render free tier — no Redis)
PROCESSING_MODE=auto

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# Render injects PORT. Production uses APP_ENV=production and DEBUG=false.
# Use independent random SECRET_KEY and JWT_SECRET_KEY values (32+ characters).
# CORS_ORIGINS=https://your-frontend.vercel.app (exact origins, comma-separated).
