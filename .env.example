# =============================================================================
# Land Record Digitization System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before running.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Land Record Digitization System"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=landrecords
POSTGRES_PASSWORD=changeme
POSTGRES_DB=landrecords
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Optional local development override, for example:
# DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./landrecords.db
DATABASE_URL_OVERRIDE=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible / MinIO)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
# Options: local (dev default, no external deps), minio, s3
LOCAL_STORAGE_DIR=uploads
# STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=land-records
MINIO_USE_SSL=false

# For production S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET=land-records

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
# Supported: tesseract, google_vision, azure_cognitive, easyocr
OCR_PRIMARY_ENGINE=tesseract
OCR_FALLBACK_ENGINE=easyocr

# Google Vision (optional)
GOOGLE_VISION_CREDENTIALS_PATH=

# Azure Cognitive Services (optional)
AZURE_COGNITIVE_ENDPOINT=
AZURE_COGNITIVE_KEY=

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Supported: openai, anthropic, local
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local LLM (Ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif,bmp,webp

# -----------------------------------------------------------------------------
# Processing
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=2
PROCESSING_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
